{
  "manifest_version": 3,
  "name": "YT Tab Downloader",
  "version": "0.4.0",
  "version_name": "0.4.0",
  "description": "Download open YouTube tabs as MP3 or MP4 with cover art and tags, via a local yt-dlp helper.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Tab Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
