{
  "manifest_version": 3,
  "name": "YT Tab Downloader",
  "version": "1.4",
  "description": "Grab the title of an open YouTube tab and download it as MP3 or MP4 via a local helper.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Tab Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
